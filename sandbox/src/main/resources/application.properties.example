#--------------------------------------------------------------------
# APPLICATION BOOTSTRAP
#--------------------------------------------------------------------

# The unique name of the application used for service identification and discovery
spring.application.name=axtrion-app

#--------------------------------------------------------------------
# DEVELOPMENT ONLY
#--------------------------------------------------------------------

# Specifies the currently active sandbox module or feature block to execute
#sandbox.active.module=hello-world

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# Default Locale (one value only, example: en, en-US, es, es-MX)
#app.default-locale=en-US

# Automatically negotiate locale from Accept-Language header
#app.negotiate-locale=false

# Application timezone (IANA Time Zone Database)
#app.time-zone=UTC

# Date and time format pattern (example: yyyy-MM-dd, yyyy-MM-dd HH:mm:ss)
#app.date-format=yyyy-MM-dd HH:mm:ss

# Default Character Set (one value only, example: US-ASCII, ISO-8859-1, UTF-8, UTF-16BE, UTF-16LE, UTF-16)
#app.charset=UTF-8

# Enable or disable application debug mode
#app.debug=false

# Directory where the application stores writable files, including application logs, cache, temporary files, and generated data
#app.paths.writable-directory=./writable

#--------------------------------------------------------------------
# Logger
#--------------------------------------------------------------------

# - 0=Disables logging, Error logging TURNED OFF
# - 1=Emergency Messages - System is unusable
# - 2=Alert Messages - Action Must Be Taken Immediately
# - 3=Critical Messages - Application component unavailable, unexpected exception.
# - 4=Runtime Errors - Don't need immediate action, but should be monitored.
# - 5=Warnings - Exceptional occurrences that are not errors.
# - 6=Notices - Normal but significant events.
# - 7=Info - Interesting events, like user logging in, etc.
# - 8=Debug - Detailed debug information.
# - 9=All Messages
#logger.threshold=4
